# HTTP port and bind address (0.0.0.0 = reachable from phones/laptops on the same Wi-Fi)
PORT=3000
HOST=0.0.0.0
# SQLite database file (:memory: is used in tests)
DB_PATH=./data/campus-wifi.db
# Leave empty: generated on first run and stored in data/.jwt-secret
JWT_SECRET=
# Defines "today" and hour-of-day buckets. Empty = server timezone
CAMPUS_TZ=
# true shortens every speed-test phase to ~3 s (demos, e2e)
SPEEDTEST_QUICK=false
# none | ollama (optional rewording of the AI summary; never required)
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
LOG_LEVEL=info
